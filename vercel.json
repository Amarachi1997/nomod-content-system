{
  "version": 2,
  "builds": [
    {
      "src": "api/tone-check.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "CLAUDE.md",
          "skills/tone-checker.md"
        ]
      }
    },
    {
      "src": "api/microcopy-gen.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "CLAUDE.md",
          "skills/microcopy-gen.md"
        ]
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/tone-check",
      "dest": "/api/tone-check.js"
    },
    {
      "src": "/api/microcopy-gen",
      "dest": "/api/microcopy-gen.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
